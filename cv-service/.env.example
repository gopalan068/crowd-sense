# CrowdSense CV Service Configuration (.env)

# Video sources per zone ("0" for webcam, or path to video file in videos/)
VIDEO_SOURCE_Z1=videos/crowd_2.mp4
VIDEO_SOURCE_Z2=models/sample_corridor.mp4

# Camera Perspective Modes: "drone" (overhead high-density) vs "cctv" (ground angle)
CAMERA_TYPE_Z1=drone
CAMERA_TYPE_Z2=cctv

# Drone Detection Tuning Parameters for Ultra-Dense Crowds (e.g. concert/festival drone views)
CONF_THRESH=0.06
NMS_IOU_THRESH=0.60
INFERENCE_IMGSZ=1280

# SAHI (Slicing Aided Hyper Inference) Flags — Fine-grained 320x320 tiles
USE_SAHI=true
SAHI_SLICE_HEIGHT=320
SAHI_SLICE_WIDTH=320
SAHI_OVERLAP_RATIO=0.20

# Analysis Intervals (Seconds per AI evaluation pass)
DRONE_ANALYSIS_INTERVAL_SEC=4.0
CCTV_ANALYSIS_INTERVAL_SEC=1.0

# Backend Endpoint
BACKEND_URL=http://localhost:4000/api/density

# Zone Specifications (Calibrated area for large open festival square)
ZONE_ID=zone_1
ZONE_TYPE=general
AREA_SQM=250.0

# Model Weights Path
MODEL_PATH=models/yolov8n.pt
ENABLE_OPTICAL_FLOW=true
