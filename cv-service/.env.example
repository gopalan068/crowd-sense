# Video source: "0" for default webcam, or path to a video file.
# WEBCAM NOTE: webcam (VIDEO_SOURCE=0) requires running cv-service NATIVELY
# (not in Docker). See docker-compose.yml for the Docker/native split.
VIDEO_SOURCE=0

# Backend endpoint — must match the backend service's host:port.
# When running backend in Docker and cv-service natively: use localhost:4000.
BACKEND_URL=http://localhost:4000/api/density

# Zone identity — must match zone definitions used in the backend and frontend.
ZONE_ID=zone_1

# Zone type: "general" or "corridor"
# "corridor" zones use tighter thresholds in the backend (Phase 3+).
ZONE_TYPE=general

# Zone area in square metres — manually calibrated estimate.
# No homography correction in Phase 1 (deliberate scope cut, see blueprint §12).
AREA_SQM=20.0

# Process every Nth frame (5 = every 5th frame at ~30fps → ~6 detections/sec).
FRAME_SAMPLE_RATE=5

# Path to pre-downloaded YOLOv8n weights.
# Run `python download_model.py` once to populate this file.
MODEL_PATH=models/yolov8n.pt

# How often (seconds) to POST an aggregated reading to the backend.
EMIT_INTERVAL_SEC=1.0
