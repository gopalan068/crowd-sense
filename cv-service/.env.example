# CrowdSense CV Service Configuration (.env)

# Video sources per zone
VIDEO_SOURCE_Z1=videos/crowd_1.mp4
VIDEO_SOURCE_Z2=videos/crowd_2.mp4

# Camera Perspective Modes: "drone" (overhead high-density) vs "cctv" (ground angle)
CAMERA_TYPE_Z1=cctv
CAMERA_TYPE_Z2=drone

# Per-Zone Physical Area in Square Meters (m²)
AREA_SQM_Z1=30.0
AREA_SQM_Z2=250.0

# Egress Exit Focal Point Coordinates (X, Y) for Optical Flow Convergence calculation
FOCAL_POINT_Z1_X=320
FOCAL_POINT_Z1_Y=240

FOCAL_POINT_Z2_X=540
FOCAL_POINT_Z2_Y=240

# Strict Mode-Specific Confidence Thresholds
CONF_THRESH_CCTV=0.30
CONF_THRESH_DRONE=0.06

# Drone Detection Tuning Parameters
NMS_IOU_THRESH=0.60
INFERENCE_IMGSZ=1280

# SAHI Flags
USE_SAHI=true
SAHI_SLICE_HEIGHT=320
SAHI_SLICE_WIDTH=320
SAHI_OVERLAP_RATIO=0.20

# Analysis Intervals (Seconds per AI evaluation pass)
DRONE_ANALYSIS_INTERVAL_SEC=4.0
CCTV_ANALYSIS_INTERVAL_SEC=1.0

# Backend Endpoint
BACKEND_URL=http://localhost:4000/api/density

# Zone Specifications
ZONE_ID=zone_1

# Model Weights Path
MODEL_PATH=models/yolov8n.pt
ENABLE_OPTICAL_FLOW=true
